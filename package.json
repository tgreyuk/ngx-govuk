{
  "name": "ngx-govuk",
  "version": "0.0.0",
  "license": "MIT",
  "scripts": {
    "demo:start": "npm run lib:typedoc && ng serve demo",
    "demo:build": "npm run lib:typedoc && ng build demo",
    "demo:test": "ng test demo --watch=false",
    "demo:lint": "ng lint demo",
    "demo:govukstyles": "sass ./projects/demo/govuk-frontend.scss ./projects/demo/govuk-frontend.css --load-path=node_modules/govuk-frontend/dist --style=compressed --quiet-deps",
    "lib:build": "ng build ngx-govuk",
    "lib:test": "ng test ngx-govuk --watch=false",
    "lib:test:watch": "ng test ngx-govuk",
    "lib:test:update": "ng test ngx-govuk --watch=false --runner-config=projects/ngx-govuk/vitest.update.config.mts",
    "lib:lint": "ng lint ngx-govuk",
    "lib:storybook": "ng run ngx-govuk:storybook",
    "lib:storybook:build": "ng run ngx-govuk:build-storybook",
    "lib:typedoc": "typedoc"
  },
  "private": true,
  "dependencies": {
    "@angular/animations": "22.2.6",
    "@angular/common": "22.2.6",
    "@angular/compiler": "22.2.6",
    "@angular/core": "22.2.6",
    "@angular/forms": "22.2.6",
    "@angular/platform-browser": "22.2.6",
    "@angular/platform-browser-dynamic": "22.2.6",
    "@angular/router": "22.2.6",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "rxjs": "~7.8.2",
    "shiki": "^1.1.6",
    "storybook": "10.6.7",
    "tslib": "^2.6.2",
    "zone.js": "0.16.1"
  },
  "devDependencies": {
    "@angular-devkit/build-angular": "22.2.7",
    "@angular-devkit/core": "22.2.7",
    "@angular-devkit/schematics": "22.2.7",
    "@angular/build": "22.2.7",
    "@angular/cli": "22.2.7",
    "@angular/compiler-cli": "22.2.6",
    "@angular/language-service": "22.2.6",
    "@eslint/js": "^10.0.1",
    "@schematics/angular": "21.2.2",
    "@storybook/angular": "10.6.7",
    "@types/node": "^22.20.5",
    "angular-eslint": "22.6.0",
    "autoprefixer": "^10.4.17",
    "eslint": "^10.14.0",
    "eslint-config-prettier": "10.1.8",
