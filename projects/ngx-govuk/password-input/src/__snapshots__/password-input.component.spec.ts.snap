// Vitest Snapshot v1, https://vitest.dev/guide/snapshot.html

exports[`NgxGovukPasswordInput > matches the GOV.UK markup snapshot 1`] = `
<ngx-govuk-password-input
  label="Password"
>
  <div
    class="govuk-form-group govuk-password-input"
  >
    <label
      class="govuk-label"
      for="password"
    >
      Password
    </label>
    <div
      class="govuk-input__wrapper govuk-password-input__wrapper"
    >
      <input
        autocapitalize="none"
        autocomplete="current-password"
        class="govuk-input govuk-password-input__input"
        id="password"
        name="password"
        ngxgovuktextinput=""
        spellcheck="false"
        type="password"
      />
      <div
        aria-live="polite"
        class="govuk-password-input__sr-status govuk-visually-hidden"
      >
          
      </div>
      <button
        aria-controls="password"
        aria-label="Show password"
        class="govuk-button govuk-button--secondary govuk-password-input__toggle"
        type="button"
      >
         Show 
      </button>
    </div>
  </div>
</ngx-govuk-password-input>
`;

exports[`NgxGovukPasswordInput > matches the GOV.UK markup snapshot with a hint and error 1`] = `
<ngx-govuk-password-input
  label="Password"
>
  <div
    class="govuk-form-group govuk-password-input govuk-form-group--error"
  >
    <label
      class="govuk-label"
      for="password"
    >
      Password
    </label>
    <div
      class="govuk-hint"
      id="password-hint"
    >
      It must be at least 8 characters
    </div>
    <p
      class="govuk-error-message"
      id="password-error"
    >
      <span
        class="govuk-visually-hidden"
      >
        Error:
      </span>
       Enter a password 
    </p>
    <div
      class="govuk-input__wrapper govuk-password-input__wrapper"
    >
      <input
        aria-describedby="password-hint password-error"
        autocapitalize="none"
        autocomplete="current-password"
        class="govuk-input govuk-password-input__input govuk-input--error"
        id="password"
        name="password"
        ngxgovuktextinput=""
        spellcheck="false"
        type="password"
      />
      <div
        aria-live="polite"
        class="govuk-password-input__sr-status govuk-visually-hidden"
      >
          
      </div>
      <button
        aria-controls="password"
        aria-label="Show password"
        class="govuk-button govuk-button--secondary govuk-password-input__toggle"
        type="button"
      >
         Show 
      </button>
    </div>
  </div>
</ngx-govuk-password-input>
`;
