// Vitest Snapshot v1, https://vitest.dev/guide/snapshot.html

exports[`NgxGovukFormGroup > matches the GOV.UK markup snapshot 1`] = `
<ngx-govuk-form-group
  label="Email address"
>
  <div
    class="govuk-form-group govuk-form-group--error"
  >
    <label
      class="govuk-label"
      for="email"
    >
      Email address
    </label>
    <div
      class="govuk-hint"
      id="email-hint"
    >
      Use your work email
    </div>
    <p
      class="govuk-error-message"
      id="email-error"
    >
      <span
        class="govuk-visually-hidden"
      >
        Error:
      </span>
       Enter an email address 
    </p>
    <input
      aria-describedby="email-hint email-error"
      autocomplete="email"
      class="govuk-input govuk-input--error"
      id="email"
      ngxgovuktextinput=""
    />
  </div>
</ngx-govuk-form-group>
`;
