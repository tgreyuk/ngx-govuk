// Vitest Snapshot v1, https://vitest.dev/guide/snapshot.html

exports[`NgxGovukNotificationBanner > matches the GOV.UK markup snapshot 1`] = `
<div>
  <ngx-govuk-notification-banner
    titleid="banner-title"
  >
    <div
      aria-labelledby="banner-title"
      class="govuk-notification-banner"
      role="region"
    >
      <div
        class="govuk-notification-banner__header"
      >
        <h2
          class="govuk-notification-banner__title"
          id="banner-title"
        >
           Important 
        </h2>
      </div>
      <div
        class="govuk-notification-banner__content"
      >
        <p
          class="govuk-notification-banner__heading"
        >
           This publication was withdrawn on 7 March 2014. 
        </p>
      </div>
    </div>
  </ngx-govuk-notification-banner>
</div>
`;

exports[`NgxGovukNotificationBanner > matches the GOV.UK markup snapshot for a success banner 1`] = `
<div>
  <ngx-govuk-notification-banner
    bannertype="success"
    titleid="banner-title"
  >
    <div
      aria-labelledby="banner-title"
      class="govuk-notification-banner govuk-notification-banner--success"
      role="alert"
    >
      <div
        class="govuk-notification-banner__header"
      >
        <h2
          class="govuk-notification-banner__title"
          id="banner-title"
        >
           Success 
        </h2>
      </div>
      <div
        class="govuk-notification-banner__content"
      >
        <p
          class="govuk-notification-banner__heading"
        >
           Email sent to example@email.com 
        </p>
      </div>
    </div>
  </ngx-govuk-notification-banner>
</div>
`;
