// Vitest Snapshot v1, https://vitest.dev/guide/snapshot.html

exports[`NgxGovukTabs > matches the GOV.UK markup snapshot on a small screen 1`] = `
<ngx-govuk-tabs
  class="govuk-tabs"
>
  <h2
    class="govuk-tabs__title"
  >
    Contents
  </h2>
  <ul
    class="govuk-tabs__list"
  >
    <li
      class="govuk-tabs__list-item govuk-tabs__list-item--selected"
    >
      <a
        class="govuk-tabs__tab"
        href="#past-day"
      >
         Past day 
      </a>
    </li>
    <li
      class="govuk-tabs__list-item"
    >
      <a
        class="govuk-tabs__tab"
        href="#past-week"
      >
         Past week 
      </a>
    </li>
    <li
      class="govuk-tabs__list-item"
    >
      <a
        class="govuk-tabs__tab"
        href="#past-month"
      >
         Past month 
      </a>
    </li>
  </ul>
  <ngx-govuk-tab
    class="govuk-tabs__panel"
    id="past-day"
    label="Past day"
  >
    Day
  </ngx-govuk-tab>
  <ngx-govuk-tab
    class="govuk-tabs__panel govuk-tabs__panel--hidden"
    id="past-week"
    label="Past week"
  >
    Week
  </ngx-govuk-tab>
  <ngx-govuk-tab
    class="govuk-tabs__panel govuk-tabs__panel--hidden"
    id="past-month"
    label="Past month"
  >
    Month
  </ngx-govuk-tab>
</ngx-govuk-tabs>
`;

exports[`NgxGovukTabs > matches the GOV.UK markup snapshot on a wide screen 1`] = `
<ngx-govuk-tabs
  class="govuk-tabs"
>
  <h2
    class="govuk-tabs__title"
  >
    Contents
  </h2>
  <ul
    class="govuk-tabs__list"
    role="tablist"
  >
    <li
      class="govuk-tabs__list-item govuk-tabs__list-item--selected"
      role="presentation"
    >
      <a
        aria-controls="past-day"
        aria-selected="true"
        class="govuk-tabs__tab"
        href="#past-day"
        id="tab_past-day"
        role="tab"
        tabindex="0"
      >
         Past day 
      </a>
    </li>
    <li
      class="govuk-tabs__list-item"
      role="presentation"
    >
      <a
        aria-controls="past-week"
        aria-selected="false"
        class="govuk-tabs__tab"
        href="#past-week"
        id="tab_past-week"
        role="tab"
        tabindex="-1"
      >
         Past week 
      </a>
    </li>
    <li
      class="govuk-tabs__list-item"
      role="presentation"
    >
      <a
        aria-controls="past-month"
        aria-selected="false"
        class="govuk-tabs__tab"
        href="#past-month"
        id="tab_past-month"
        role="tab"
        tabindex="-1"
      >
         Past month 
      </a>
    </li>
  </ul>
  <ngx-govuk-tab
    aria-labelledby="tab_past-day"
    class="govuk-tabs__panel"
    id="past-day"
    label="Past day"
    role="tabpanel"
  >
    Day
  </ngx-govuk-tab>
  <ngx-govuk-tab
    aria-labelledby="tab_past-week"
    class="govuk-tabs__panel govuk-tabs__panel--hidden"
    id="past-week"
    label="Past week"
    role="tabpanel"
  >
    Week
  </ngx-govuk-tab>
  <ngx-govuk-tab
    aria-labelledby="tab_past-month"
    class="govuk-tabs__panel govuk-tabs__panel--hidden"
    id="past-month"
    label="Past month"
    role="tabpanel"
  >
    Month
  </ngx-govuk-tab>
</ngx-govuk-tabs>
`;
