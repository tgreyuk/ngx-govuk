// Vitest Snapshot v1, https://vitest.dev/guide/snapshot.html

exports[`NgxGovukRadios > matches the GOV.UK markup snapshot 1`] = `
<ngx-govuk-radios
  class="ng-untouched ng-pristine ng-valid"
  id="contact-radios"
  legend="How would you like to be contacted?"
  name="contact"
>
  <div
    class="govuk-form-group govuk-form-group--error"
  >
    <fieldset
      aria-describedby="contact-hint contact-error"
      class="govuk-fieldset"
    >
      <legend
        class="govuk-fieldset__legend govuk-fieldset__legend--l"
      >
        <h1
          class="govuk-fieldset__heading"
        >
          How would you like to be contacted?
        </h1>
      </legend>
      <div
        class="govuk-hint"
        id="contact-hint"
      >
        Select one option
      </div>
      <p
        class="govuk-error-message"
        id="contact-error"
      >
        <span
          class="govuk-visually-hidden"
        >
          Error:
        </span>
         Select how you would like to be contacted 
      </p>
      <div
        class="govuk-radios"
      >
        <ngx-govuk-radio
          class="govuk-radios__item"
          value="email"
        >
          <input
            class="govuk-radios__input"
            id="contact"
            name="contact"
            type="radio"
            value="email"
          />
          <label
            class="govuk-label govuk-radios__label"
            for="contact"
          >
            Email
          </label>
        </ngx-govuk-radio>
        <ngx-govuk-radio
          class="govuk-radios__item"
          hint="We'll call in office hours"
          value="phone"
        >
          <input
            aria-describedby="contact-2-item-hint"
            class="govuk-radios__input"
            id="contact-2"
            name="contact"
            type="radio"
            value="phone"
          />
          <label
            class="govuk-label govuk-radios__label"
            for="contact-2"
          >
             Phone 
          </label>
          <div
            class="govuk-hint govuk-radios__hint"
            id="contact-2-item-hint"
          >
            We'll call in office hours
          </div>
        </ngx-govuk-radio>
        <ngx-govuk-radio
          class="govuk-radios__item"
          value="post"
        >
          <input
            class="govuk-radios__input"
            disabled=""
            id="contact-3"
            name="contact"
            type="radio"
            value="post"
          />
          <label
            class="govuk-label govuk-radios__label"
            for="contact-3"
          >
            Post
          </label>
        </ngx-govuk-radio>
      </div>
    </fieldset>
  </div>
</ngx-govuk-radios>
`;
