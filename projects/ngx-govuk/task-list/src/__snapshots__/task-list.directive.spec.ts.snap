// Vitest Snapshot v1, https://vitest.dev/guide/snapshot.html

exports[`NgxGovukTaskList > matches the GOV.UK markup snapshot 1`] = `
<div>
  <ul
    class="govuk-task-list"
    ngxgovuktasklist=""
  >
    <li
      class="govuk-task-list__item govuk-task-list__item--with-link"
      link="/directors"
      ngxgovuktasklistitem=""
      titletext="Company Directors"
    >
      <div
        class="govuk-task-list__name-and-hint"
      >
        <a
          aria-describedby="id-0"
          class="govuk-link govuk-task-list__link"
          href="/directors"
        >
          Company Directors
        </a>
      </div>
      <div
        class="govuk-task-list__status"
        id="id-0"
      >
         Completed 
      </div>
    </li>
    <li
      class="govuk-task-list__item govuk-task-list__item--with-link"
      hint="Include 5 years of the company’s relevant financial information"
      link="/financial-history"
      ngxgovuktasklistitem=""
      titletext="Financial history"
    >
      <div
        class="govuk-task-list__name-and-hint"
      >
        <a
          aria-describedby="id-1 id-2"
          class="govuk-link govuk-task-list__link"
          href="/financial-history"
        >
          Financial history
        </a>
        <div
          class="govuk-task-list__hint"
          id="id-1"
        >
          Include 5 years of the company’s relevant financial information
        </div>
      </div>
      <div
        class="govuk-task-list__status"
        id="id-2"
      >
        <strong
          class="govuk-tag"
          ngxgovuktag=""
        >
          Incomplete
        </strong>
      </div>
    </li>
    <li
      class="govuk-task-list__item"
      ngxgovuktasklistitem=""
      titletext="Submit and pay"
    >
      <div
        class="govuk-task-list__name-and-hint"
      >
        <div>
          Submit and pay
        </div>
      </div>
      <div
        class="govuk-task-list__status govuk-task-list__status--cannot-start-yet"
        id="id-3"
      >
         Cannot start yet 
      </div>
    </li>
  </ul>
</div>
`;
